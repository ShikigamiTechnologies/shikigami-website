{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shikigami-tech",
  "main": "worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "CYPHER_MAX_UPLOAD_BYTES": "15728640",
    "CYPHER_AZURE_ENABLED": "true",
    "CYPHER_OPENAI_ENABLED": "true",
    "CYPHER_OPENAI_MODEL": "gpt-5.6-terra",
    "CYPHER_OPENAI_FALLBACK_MODEL": "gpt-5.6-sol",
    "CYPHER_SUPABASE_ENABLED": "true",
    "SUPABASE_URL": "http://127.0.0.1:54321"
  },
  "d1_databases": [
    {"binding":"LEADS","database_name":"shikigami-website-leads","database_id":"6e8be704-03ae-4b7b-8cef-e9bca811ef7d"},
    {"binding":"LICENSING","database_name":"cypher-licensing","database_id":"849ee0cb-8167-4cbd-adc2-a0fc3a0c9619","migrations_dir":"migrations/licensing"}
  ],
  "observability": {"enabled":true,"head_sampling_rate":1},
  "env": {
    "staging": {
      "name": "shikigami-tech-staging",
      "workers_dev": false,
      "route": {
        "pattern": "cypher-staging.shikigamitechnologies.com",
        "custom_domain": true
      },
      "vars": {
        "DEPLOYMENT_ENV": "staging",
        "CYPHER_MAX_UPLOAD_BYTES": "15728640",
        "CYPHER_AZURE_ENABLED": "false",
        "CYPHER_OPENAI_ENABLED": "false",
        "CYPHER_SUPABASE_ENABLED": "true",
        "SUPABASE_URL": "https://svfdvbtqbaiyefcojroe.supabase.co",
        "SUPABASE_PROJECT_ORIGIN": "https://svfdvbtqbaiyefcojroe.supabase.co",
        "CYPHER_STAGING_MODE": "synthetic_only",
        "CYPHER_LIVE_CONNECTORS_ENABLED": "false"
      },
      "triggers": { "crons": ["*/2 * * * *"] }
    }
  }
}
